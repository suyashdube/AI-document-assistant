# API Keys
# --------
# Your OpenAI API key for LLM operations
OPENAI_API_KEY=your_openai_api_key_here

# Your Permit.io API key for authorization
PERMIT_API_KEY=your_permit_api_key_here

# Permit.io Configuration
# ---------------------
# URL of the Permit.io Policy Decision Point (PDP)
# For local development with Docker, use http://localhost:7766
PERMIT_PDP_URL=http://localhost:7766

# Application Configuration
# -----------------------
# Secret key for JWT token generation (generate a secure random string)
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# API Configuration
# ---------------
# API host and port
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=true

# AI Configuration
# --------------
# Default language model to use
OPENAI_MODEL=gpt-3.5-turbo
# Maximum tokens for AI responses
MAX_TOKENS=1000
# Temperature for AI responses (0.0-1.0, lower is more deterministic)
AI_TEMPERATURE=0.1

# Document Storage Configuration
# ----------------------------
# Set to 'memory' for development, 'disk' or other options for production
STORAGE_TYPE=memory
# Optional: path for document storage when using disk storage
# STORAGE_PATH=./data/documents

# Security Settings
# ---------------
# CORS origins - comma-separated list of allowed origins
CORS_ORIGINS=*
# Set to 'true' to use mock responses when OpenAI is unavailable
ALLOW_MOCK_RESPONSES=true 